# คัดลอกเป็น deploy/.env.deploy แล้วแก้ค่า (ไฟล์นี้ถูก gitignore)

# พอร์ตที่เปิดหน้าเว็บบนโฮสต์
WEB_PORT=8080

# PostgreSQL ภายใน compose
POSTGRES_USER=pdfstudio
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=pdf_studio

# โดเมนจริงที่ผู้ใช้เปิด — ต้องตรงเป๊ะกับ origin ของเบราว์เซอร์
# (ใช้ตรวจ CSRF และ cookie ของ session) ตัวอย่าง: https://pdf.home.lan
APP_ORIGIN=https://pdf.home.lan

# Google Identity Services (เว้นว่างได้ ถ้าไม่ต้องการ sign-in)
# ต้องเพิ่ม APP_ORIGIN ใน Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# เครดิต: ผู้ทดลองได้ครั้งเดียวต่อเบราว์เซอร์ และสมาชิกใหม่ได้โบนัสครั้งเดียว
ANON_CREDITS=3
SIGNUP_BONUS_CREDITS=20
SHARE_MAX_BYTES=26214400
SHARE_TTL_DAYS=7
SESSION_TTL_DAYS=30

# อีเมลยืนยันบัญชี (OTP 6 หลัก) — SMTP ของคุณเอง
# smtp://user:pass@host:587 (STARTTLS) หรือ smtps://user:pass@host:465 (SSL)
# เว้นว่างบน production = ส่งเมลไม่ได้ ระบบจะไม่บังคับยืนยันอีเมล (แต่ยังเตือนผู้ใช้)
SMTP_URL=
MAIL_FROM=PDF Studio <no-reply@pdf.home.lan>
