# คัดลอกเป็น .env แล้วแก้ค่าตามเครื่องคุณ (.env ถูก gitignore)

# PostgreSQL 17 ที่รันอยู่ในเครื่อง (สร้างฐานข้อมูลด้วย pnpm db:create)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdf_studio
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdf_studio_test

# API (Vite proxy /api มาที่นี่)
API_PORT=8787
API_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5174

# Google Identity Services — ใส่ client id จาก Google Cloud Console
# ต้องเพิ่ม http://127.0.0.1:5174 ใน Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# โควตา anonymous (ครั้ง/24 ชม.) และลิงก์แชร์
ANON_CREDITS=3
SHARE_MAX_BYTES=26214400
SHARE_TTL_DAYS=7
SESSION_TTL_DAYS=30

# เครดิตเริ่มต้นที่สมาชิกใหม่ได้รับ (ให้ครั้งเดียวต่อบัญชี)
SIGNUP_BONUS_CREDITS=20
