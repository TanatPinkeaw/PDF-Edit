{
  "name": "pdf-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "sample": "node scripts/make-sample.mjs",
    "db:create": "node --env-file-if-exists=.env server/src/db/create.ts",
    "db:migrate": "node --env-file-if-exists=.env server/src/db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env server/src/db/reset.ts"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "pdfjs-dist": "4.10.38",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
